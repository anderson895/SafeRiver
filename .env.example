# Copy to .env.local and fill in. NEVER commit .env.local (it is gitignored).

# ---- Firebase client (safe to expose — these ship in the browser bundle) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- Firebase Admin (SECRET) ----
# Base64 of the whole service-account JSON. Base64 avoids the newline mangling
# that breaks `private_key` when pasted into a Vercel env var.
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_PROJECT_ID=

# ---- Cron / automation (SECRET) ----
# openssl rand -hex 32   (or)   PowerShell: -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) })
CRON_SECRET=
ADMIN_ALERT_EMAIL=

# ---- Email (SECRET) ----
# Nodemailer + Gmail SMTP. SMTP_PASS must be a Google *App Password*
# (Account > Security > 2-Step Verification > App passwords), NOT your
# normal account password. Free Gmail allows ~500 recipients per 24h;
# the dispatcher self-limits to 400/day to stay clear of that ceiling.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME="San Manuel Flood Information System"
MAIL_FROM_ADDRESS=

# HMAC pepper for subscribe-confirm and unsubscribe tokens (SECRET)
TOKEN_SECRET=

# ---- App config ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_PMTILES_URL=/tiles/sanmanuel-flood.pmtiles
PAGASA_FLOOD_URL=https://www.pagasa.dost.gov.ph/flood

# San Manuel, Pangasinan
OPEN_METEO_LAT=16.0708
OPEN_METEO_LON=120.6647

# ---- Kill switches ----
# false = evaluate rules and log alerts, but send no email. Use while testing.
ALERTS_ENABLED=false
# true = serve committed fixtures instead of live data. Thesis-defense insurance.
DEMO_MODE=false
