{
  "name": "sanmanuel-flood-info",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "gis:build": "node --max-old-space-size=8192 scripts/gis/build-layers.mjs",
    "smoke:scrape": "tsx scripts/smoke-scrape.ts --live",
    "smoke:email": "tsx --conditions=react-server --env-file=.env.local scripts/smoke-email.ts",
    "db:status": "tsx --conditions=react-server --env-file=.env.local scripts/db-status.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/material-nextjs": "^9.3.0",
    "@mui/x-charts": "^9.11.1",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "maplibre-gl": "^6.4.1",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.2",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "mapshaper": "^0.7.54",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
