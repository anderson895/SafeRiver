# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and documents required config,
# so it must be committed. Without this, a fresh clone has no idea what
# environment variables the app needs.
!.env.example

# secrets — NEVER commit. This repo is intended to be public so that
# GitHub Actions scheduled workflows stay free (see .github/workflows/poll.yml).
credentials.txt
*credentials*.json
serviceAccount*.json
*.key

# GIS working directory — raw NOAH downloads are ~150 MB and are fully
# reproducible via `npm run gis:build`. Only the built layers in public/geo
# are committed.
/data/

# Vendored MapLibre worker, copied out of node_modules by
# scripts/copy-maplibre-worker.mjs on postinstall/predev/prebuild.
# Deliberately NOT committed: a checked-in copy would drift from the installed
# maplibre-gl version, which is the exact failure this script prevents.
/public/maplibre/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
details.txt
