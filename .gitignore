# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and documents required config,
# so it must be committed. Without this, a fresh clone has no idea what
# environment variables the app needs.
!.env.example

# secrets — NEVER commit. This repo is intended to be public so that
# GitHub Actions scheduled workflows stay free (see .github/workflows/poll.yml).
credentials.txt
*credentials*.json
serviceAccount*.json
*.key

# GIS working directory — raw NOAH downloads are ~150 MB and are fully
# reproducible via `npm run gis:build`. Only the built layers in public/geo
# are committed.
/data/

# Documentation screenshots — generated, never committed.
#
# `npm run screenshots` rewrites all ~32 images on every run, and because each
# frame contains a live clock and live readings, every byte differs. Nothing
# dedupes, so each run added ~7 MB of permanent history: 417 blobs across 15
# commits, and an 89 MB push.
#
# Regenerate them on demand instead. They are documentation output, not source.
/screenshot/

# Built documentation. `npm run docs:docx` embeds the screenshots above, so the
# .docx is several MB of the same non-deduping image data — it belongs in a
# submission folder, not in git. Regenerate it from DOCUMENTATION.md instead.
/documentation.docx

# Vendored MapLibre worker, copied out of node_modules by
# scripts/copy-maplibre-worker.mjs on postinstall/predev/prebuild.
# Deliberately NOT committed: a checked-in copy would drift from the installed
# maplibre-gl version, which is the exact failure this script prevents.
/public/maplibre/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
details.txt
